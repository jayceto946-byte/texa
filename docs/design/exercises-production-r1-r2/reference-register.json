  "authority": "Task-specific implementation reference; R2 explicit amendments override R1. Not permanent global product authority.",
  "archive": "reference-r1-r2.zip",
  "archive_sha256": "d7d97efc5ff594800ad3d6c087f60dabcc8e42b652f558073e400960f1db137f",
  "decisions": [
    "Bounded preparation and source canvas; one source form at a time",
    "Candidate index plus one document; comparison hides index",
    "Focused reading max 810px; 40/60 when actual workspace >=992px; otherwise one active pane",
    "Exercise AI creates draft and requires explicit save; mistake AI has distinct direct-write contract"
  ],
  "known_reference_limits": [
    "Static prototype data and model output",
    "Prototype browser captures are not production Electron QA",
    "No real OCR, model, backend, restart or usability validation in the references"
  ],
  "implementation_differences": [
    "Existing native application chrome retained",
    "Candidate titles use deterministic excerpts with formula placeholders",
    "Exercise API lacks question-text update endpoint: Astra accepted read-only question plus real management/answer editing for this round",
    "Mistake explain lacks CAS/idempotency: Astra accepted unavailable AI status and saved explanation, with no disabled write action",
    "Path-only bank images unavailable: Astra accepted explicit source-file notice; existing Markdown/mistake image reads remain"
  ],
