.notes-workspace { display:flex; flex-direction:column; height:100%; min-width:0; color:var(--color-text-primary); background:var(--workspace-canvas); }
.notes-workspace .note-page-header { display:flex; align-items:center; justify-content:space-between; gap:12px; flex:0 0 var(--workspace-chrome-height); height:var(--workspace-chrome-height); min-height:var(--workspace-chrome-height); padding:0 var(--workspace-management-gutter); border-bottom:1px solid var(--workspace-separator); }
.note-page-header h1 { font-size:var(--workspace-page-title-size); line-height:1.3; font-weight:600; white-space:nowrap; margin:0; }
.note-page-header .note-actions { flex-wrap:nowrap; margin-left:auto; white-space:nowrap; gap:6px; }
.note-header-state,.note-save-status { font-size:var(--workspace-meta-size); color:var(--color-text-secondary); }
.note-scroll { flex:1; overflow:auto; min-height:0; }
.note-delete-recovery { position:sticky; top:0; z-index:2; display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:10px; padding:8px 16px; background:var(--workspace-secondary); border-bottom:1px solid var(--workspace-separator); font-size:var(--workspace-interface-size); }
.note-document { max-width:calc(var(--workspace-reading-width) + 2 * var(--workspace-reading-gutter)); margin:0 auto; padding:28px var(--workspace-reading-gutter) 70px; overflow-wrap:anywhere; font-size:var(--workspace-reading-size); line-height:var(--workspace-reading-leading); }
.note-document-title { font-size:var(--workspace-document-title-size); line-height:1.5; font-weight:600; margin:0 0 16px; }
.note-document h2 { font-size:var(--workspace-section-title-size); font-weight:600; }
.note-caption { color:var(--color-text-secondary); font-size:var(--workspace-support-size); line-height:1.7; margin:5px 0 12px; }
.note-abstract { margin:0 0 20px; color:var(--color-text-secondary); }
.note-actions { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
.note-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:6px; color:var(--color-text-secondary); font-size:var(--workspace-meta-size); }
.note-block { position:relative; padding:0; min-width:0; scroll-margin-top:16px; }
/* Keep the note reading role at compact widths despite shared Markdown density. */
.notes-workspace .note-reading .markdown-body.learning-reading-content { font-size:var(--workspace-reading-size); line-height:var(--workspace-reading-leading); color:var(--workspace-reading-text); }
.notes-workspace .note-reading .markdown-body.learning-reading-content :is(p,ul,ol,li) { line-height:var(--workspace-reading-leading); }
.note-reading .markdown-body h1 { font-size:var(--workspace-document-title-size); }
.note-reading .markdown-body h2 { font-size:var(--workspace-section-title-size); margin-top:24px; }
.note-reading .markdown-body h3 { font-size:var(--workspace-subheading-size); }
.note-reading .markdown-body :is(p,ul,ol) { margin:0 0 16px; }
.note-reading .katex-display, .note-source-inspector .katex-display { overflow-x:auto; overflow-y:hidden; max-width:100%; padding:5px 0; }
.note-reading table { display:block; max-width:100%; overflow:auto; }
.note-warning { border-left:3px solid var(--warning); background:var(--workspace-secondary); padding:10px 14px; margin:14px 0; font-size:var(--workspace-interface-size); line-height:1.7; }
.note-warning-label { display:inline-block; font-size:var(--workspace-meta-size); border:1px solid var(--workspace-separator); border-radius:4px; padding:2px 6px; margin-right:8px; }
.note-fields { padding:0; border:0; margin:16px 0; min-width:0; }
.note-fields label, .note-preflight-settings>label, .note-filters label, .note-edit-block>label { display:flex; flex-direction:column; gap:7px; font-size:var(--workspace-interface-size); margin:14px 0; min-width:0; }
.note-fields input:not([type=checkbox]), .note-fields textarea, .note-fields select, .note-dialog select, .note-filters input, .note-filters select, .note-search input { border:1px solid var(--workspace-separator); border-radius:var(--workspace-control-radius); background:var(--workspace-canvas); color:var(--color-text-primary); padding:7px 10px; width:100%; min-width:0; font-family:var(--font-app); font-size:var(--workspace-interface-size); }
.notes-workspace :is(input,textarea,button,a,summary):focus-visible,.note-dialog :is(input,select,button,a,summary):focus-visible { outline:2px solid var(--color-accent); outline-offset:2px; }
.note-fields textarea { min-height:85px; resize:vertical; line-height:1.8; }
.note-fields-row { display:flex; gap:16px; }.note-fields-row>label { flex:1; }
.note-edit-block { margin:16px 0; border:1px solid transparent; border-bottom-color:var(--workspace-separator); border-radius:var(--workspace-control-radius); padding:10px; scroll-margin-top:16px; }
.note-edit-block:focus-within { border-color:var(--workspace-separator); background:var(--workspace-secondary); }
.note-edit-block:focus-visible { outline:2px solid var(--color-accent); outline-offset:2px; }
.note-edit-block:is(:hover,:focus-within) .app-icon-button:not(:disabled) { color:var(--color-text-primary); }
.note-edit-block .note-block-input { margin:0; }
.note-edit-block .note-block-input textarea { border-color:transparent; background:transparent; font-size:var(--workspace-reading-size); line-height:var(--workspace-reading-leading); }
.note-fields .note-autosize { min-height:40px; max-height:min(60vh,520px); resize:none; overflow-y:auto; }
.note-edit-heading .note-block-input textarea { font-size:var(--workspace-subheading-size); font-weight:600; line-height:1.5; }
.note-fields .note-title-field { margin-top:0; }
.note-fields .note-title-input { font-size:var(--workspace-document-title-size); font-weight:600; line-height:1.5; border-color:transparent; padding-inline:0; }
.note-visually-hidden { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
.notes-workspace .note-equation-editor .visual-math-field:focus-within { border-color:transparent; box-shadow:none; outline:2px solid var(--color-accent); outline-offset:2px; }
.note-checkbox, .note-fields .note-checkbox { display:flex !important; flex-direction:row !important; align-items:center; gap:8px; }
.note-source-selection label, .note-turn-selection label { display:flex; align-items:center; gap:8px; margin:10px 0; font-size:var(--workspace-interface-size); }
.note-turn-selection { max-height:250px; overflow:auto; }
.note-dialog { width:min(580px,calc(100vw - 32px)); max-height:calc(100dvh - 48px); overflow:auto; padding:24px; background:var(--workspace-canvas); color:var(--color-text-primary); }
.note-dialog h2 { font-size:var(--workspace-page-title-size); font-weight:600; }.note-dialog p { line-height:1.7; font-size:var(--workspace-interface-size); margin:12px 0; }
.note-dialog details { margin-top:16px; }.note-dialog summary { font-size:var(--workspace-interface-size); }
.note-preflight-origin { font-weight:500; overflow-wrap:anywhere; }
.note-preflight-footer { display:flex; justify-content:flex-end; padding-top:20px; }
.note-existing-draft { display:flex; margin:8px 0; white-space:normal; }
.note-list-controls { padding:16px var(--workspace-management-gutter) 12px; border-bottom:1px solid var(--workspace-separator); font-size:var(--workspace-interface-size); }
.note-list-toolbar { display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
.note-tabs { display:flex; gap:4px; }.note-tabs .is-selected { background:var(--workspace-secondary); color:var(--color-accent); }
.note-search { flex:1; min-width:180px; max-width:360px; }
.note-filters { display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; }
.note-list { max-width:1080px; padding:10px var(--workspace-management-gutter) 40px; margin:0 auto; }
.note-list-item { display:flex; align-items:center; justify-content:space-between; gap:16px; border-bottom:1px solid var(--workspace-separator); padding:18px 0; }
.note-list-item-main { min-width:0; flex:1; }.note-list-title { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; font-size:var(--workspace-subheading-size); font-weight:600; line-height:1.6; overflow-wrap:anywhere; }
.note-list-item-main>p:not(.note-caption) { font-size:var(--workspace-interface-size); color:var(--color-text-secondary); margin:8px 0; line-height:1.7; }
.note-empty { padding:60px 10px; text-align:center; }.note-empty h2 { font-size:var(--workspace-section-title-size); font-weight:600; }.note-empty p { font-size:var(--workspace-interface-size); margin:12px 0 22px; }
.note-toc-link { display:block; font-size:var(--workspace-interface-size); padding:4px 0; }
.note-document>details { font-size:var(--workspace-interface-size); margin:12px 0 20px; }
.note-source-inspector section { padding:12px 0 20px; border-bottom:1px solid var(--workspace-separator); min-width:0; overflow-wrap:anywhere; }
.note-source-inspector details { margin:14px 0; }
.context-session-entry { display:flex; align-items:center; gap:2px; min-width:0; }
.context-session-entry .context-session-row { flex:1; min-width:0; }
.context-session-entry>.workspace-overflow-trigger { flex-shrink:0; opacity:0; }
.context-session-entry:is(:hover,:focus-within):not([hidden])>.workspace-overflow-trigger,.context-session-entry:has(.is-active)>.workspace-overflow-trigger,.workspace-overflow-trigger[aria-expanded=true] { opacity:1; }
.context-session-error { padding:8px; font-size:12px; color:var(--danger); }
.app-shell[data-context="open"]:has(.learning-context-sidebar:not([hidden]) .context-session-row.is-active) .current-session-menu { display:none; }
@media(max-width:1024px) { .note-page-header { gap:8px; } }
@media(max-width:760px) { .note-page-header { padding-right:12px; }.note-page-header .note-actions { gap:6px; }.note-page-header .note-actions :is(button,a) { padding-inline:8px; }.note-fields-row { flex-direction:column; gap:0; }.note-filters { grid-template-columns:1fr; }.note-document { padding-right:20px; }.context-session-entry>.workspace-overflow-trigger { opacity:1; } }
@media(hover:none) { .context-session-entry>.workspace-overflow-trigger { opacity:1; } }

@media(max-width:600px) {
  .notes-workspace .note-page-header { height:auto; min-height:var(--workspace-chrome-height); flex-basis:auto; flex-wrap:wrap; padding-block:8px; }
  .note-page-header .note-actions { flex-wrap:wrap; white-space:normal; }
  .note-fields :is(input:not([type=checkbox]),textarea,select) { font-size:16px; }
  .note-edit-block { padding:12px; }
  .note-document { padding-bottom:calc(70px + env(safe-area-inset-bottom)); }
}

/* One note command row; navigation, identity, state and actions share its centerline. */
.app-shell[data-layout] .management-workspace.notes-workspace .note-page-header { display:flex; height:var(--workspace-chrome-height); min-height:var(--workspace-chrome-height); flex:0 0 var(--workspace-chrome-height); flex-wrap:nowrap; padding-block:0; }
.note-header-identity { display:flex; align-items:center; gap:10px; min-width:0; flex:1; }
.note-header-identity h1 { flex-shrink:0; }
.note-header-identity>:is(.note-header-state,.note-save-status) { font-size:var(--workspace-support-size); line-height:1.4; min-width:0; }
.note-page-header>.note-actions { flex-shrink:0; flex-wrap:nowrap; }
@media(max-width:919px) {
  .app-shell[data-layout] .management-workspace.notes-workspace .note-page-header { height:56px; min-height:56px; flex-basis:56px; padding-block:6px; }
}
@media(max-width:760px) {
  .app-shell .notes-workspace .note-page-header .note-actions>:is(button,a) { min-height:44px; }
  body:has(.desktop-titlebar-marker.is-macos:not(.is-fullscreen)) .app-shell[data-navigation="closed"] .notes-workspace .note-page-header { padding-left:160px; }
}
@media(max-width:600px) {
  .app-shell[data-layout] .management-workspace.notes-workspace .note-page-header { height:auto; flex-basis:auto; flex-wrap:wrap; }
  .note-header-identity { min-height:44px; flex-basis:100%; }
}
.note-document>.note-meta-details { margin:0 0 12px; }
.note-meta-details>summary { display:inline-flex; align-items:center; gap:4px; min-height:28px; padding:4px 0; list-style:none; cursor:pointer; color:var(--color-text-secondary); font-size:var(--workspace-support-size); }
.note-meta-details>summary::-webkit-details-marker { display:none; }
.note-meta-details>summary svg { flex-shrink:0; }
.note-meta-details[open]>summary svg { transform:rotate(90deg); }
.note-meta-content { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; border-block:1px solid var(--workspace-separator); padding:12px 0; margin-top:8px; }
.note-meta-content>div:only-child { grid-column:1 / -1; }
.note-document .note-meta-content h2 { margin:0 0 8px; font-size:var(--workspace-interface-size); }
.note-meta-content .note-caption { margin:0 0 8px; }
.note-meta-facts { display:grid; grid-template-columns:auto minmax(0,1fr); gap:6px 12px; margin:0 0 8px; color:var(--color-text-secondary); font-size:var(--workspace-support-size); line-height:1.7; }
.note-meta-facts dd { margin:0; }
.note-meta-details+.note-reading .note-block:first-child .markdown-body h2 { margin-top:12px; }
@media(max-width:760px) { .note-meta-details>summary,.note-meta-content .note-toc-link { min-height:44px; }.note-meta-content .note-toc-link { display:flex; align-items:center; } }
@media(max-width:600px) { .note-meta-content { grid-template-columns:minmax(0,1fr); } }
