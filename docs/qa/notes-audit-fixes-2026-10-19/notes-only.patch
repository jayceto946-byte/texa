+.app-shell[data-layout] .management-workspace.notes-workspace .note-page-header { display:grid; grid-template-columns:auto minmax(0,1fr) auto; grid-template-areas:"title state actions"; }
+.note-page-header>h1 { grid-area:title; }
+.note-page-header>:is(.note-header-state,.note-save-status) { grid-area:state; justify-self:end; white-space:normal; }
+.note-page-header>.note-actions { grid-area:actions; }
+@media(max-width:760px) {
+  .app-shell[data-layout] .management-workspace.notes-workspace .note-page-header { grid-template-columns:auto minmax(0,1fr); grid-template-areas:"title state" "actions actions"; height:auto; min-height:var(--workspace-chrome-height); flex:0 0 auto; padding-block:8px; row-gap:6px; }
+  .note-page-header>.note-actions { justify-self:end; flex-wrap:wrap; }
+  .note-page-header>h1 { white-space:normal; }
+  .app-shell .notes-workspace .note-page-header .note-actions>:is(button,a) { min-height:44px; }
+}
