+    def confirm(cid):
+        writes.append(cid)
+        receipt.update(mistake_id=cid)
+        return {'result':dict(receipt)}
+    monkeypatch.setattr(pending, 'confirm', confirm)
+    monkeypatch.setattr(pending, 'domain_receipt', lambda _: dict(receipt) or None)
