{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state_operations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "operation": {
                "enum": [
                  "clarify"
                ]
              }
            },
            "required": [
              "operation"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "enum": [
                  "resolve_reference"
                ]
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "operation",
              "value"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 1
    }
  },
  "required": [
    "state_operations"
  ],
  "additionalProperties": false,
  "description": "Strict benchmark wire profile. See Spec for runtime parser tolerances and cross-field invariants."
}
