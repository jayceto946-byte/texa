{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "enum": [
        "direct_answer",
        "capability",
        "clarify",
        "unsupported"
      ]
    },
    "selected_capability": {
      "type": "string"
    },
    "rule_match": {
      "type": "string"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "mode",
    "selected_capability",
    "rule_match",
    "reason_codes"
  ],
  "additionalProperties": false,
  "description": "Strict benchmark wire profile. See Spec for runtime parser tolerances and cross-field invariants."
}
